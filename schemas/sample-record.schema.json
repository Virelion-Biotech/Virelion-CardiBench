{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Virelion-Biotech/Virelion-CardiBench/schemas/sample-record.schema.json",
  "title": "CardiBench Normalized Sample Record",
  "type": "object",
  "required": ["dataset_id","sample_id","study_id","organism","tissue","modality","raw_condition"],
  "properties": {
    "dataset_id": {"type":"string", "minLength":1},
    "sample_id": {"type":"string", "minLength":1},
    "study_id": {"type":"string", "minLength":1},
    "subject_id": {"type":["string","null"]},
    "biological_group": {"type":["string","null"]},
    "technical_group": {"type":["string","null"]},
    "organism": {"type":"string", "minLength":1},
    "tissue": {"type":"string", "minLength":1},
    "modality": {"type":"string", "minLength":1},
    "raw_condition": {"type":"string", "minLength":1},
    "normalized_label": {"type":["string","null"]},
    "timepoint": {"type":["string","null"]},
    "region": {"type":["string","null"]},
    "cell_context": {"type":["string","null"]}
  },
  "additionalProperties": false
}
